<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.chatflow</groupId>
    <artifactId>chatflow-consumer-v3</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ChatFlow Consumer v3 (Assignment 3 - with PostgreSQL persistence)</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- ── 已有依赖（保持不变）──────────────────────────────── -->

        <!-- Spring Web (for HTTP client and health endpoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- RabbitMQ Java Client -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
            <version>5.20.0</version>
        </dependency>

        <!-- Jackson JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Jackson JSR310 (for Instant serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ── Assignment 3 新增：PostgreSQL 持久化 ──────────────── -->

        <!-- Spring Data JPA: @Entity, JpaRepository, @Query(nativeQuery) -->
        <!-- Used by DatabaseWriterService for batch insert to PostgreSQL  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC Driver (runtime only, not needed at compile) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- jar name: chatflow-consumer-v3.jar -->
        <!-- distinguishes from Assignment 2 chatflow-consumer.jar on EC2 -->
        <finalName>chatflow-consumer-v3</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>